# CHAT_PASSWORD: Required server password to enter the private chat room.
# The server will fail to start if this is not configured.
CHAT_PASSWORD="your_password_here"

# PORT: Optional port for the HTTP/WebSocket server (defaults to 3000)
PORT=3000

# TRUST_PROXY: Set to "true" when running behind a trusted reverse proxy (e.g. Nginx, Cloud Run)
# When false or unset, the server strictly uses socket.remoteAddress to prevent X-Forwarded-For spoofing.
TRUST_PROXY=false

# APP_URL: The URL where this applet is hosted (optional).
APP_URL="MY_APP_URL"
